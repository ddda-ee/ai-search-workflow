# 当前使用的大模型服务商（openai / deepseek / qwen / moonshot / zhipu / siliconflow / openrouter / ollama / custom）
LLM_PROVIDER=deepseek

# 单模型兼容配置（switch_llm.py 与旧版 LLMClient 使用）
MODEL_NAME=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 各服务商专用 Key（按需填写，llm_config.yaml 通过 ${VAR} 引用）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# SearXNG 实例地址（可选，默认 http://localhost:8080）
SEARXNG_BASE_URL=http://localhost:8080